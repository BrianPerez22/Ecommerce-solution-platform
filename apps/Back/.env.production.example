# Plantilla de referencia para producción. NO es un archivo real de secretos —
# cópialo como `.env.production` (ya ignorado por git) y rellena los valores reales,
# o mejor aún: pega estos mismos nombres directamente como variables de entorno en
# Azure App Service (Fase 3) en vez de subir un archivo .env a ningún lado.

# --- Base de datos (Fase 2) ---
# Formato de Azure Database for PostgreSQL flexible server. sslmode=require es obligatorio.
DATABASE_URL=postgresql://<usuario>:<password>@<nombre-servidor>.postgres.database.azure.com:5432/sanddy_almacen?sslmode=require

# --- Servidor (Fase 3) ---
PORT=3001
CORS_ORIGIN=https://<tu-dominio-de-produccion>

# --- Imágenes (Fase 1) ---
STORAGE_DRIVER=azure
AZURE_STORAGE_CONNECTION_STRING=<connection string real de la cuenta de Storage>
AZURE_STORAGE_CONTAINER=productos

# --- Autenticación (Fase 5) ---
# Nunca reutilices los valores de .env.example — generar nuevos para producción.
JWT_SECRET=<valor aleatorio largo, ej. `openssl rand -hex 32`>
ADMIN_INITIAL_USERNAME=<usuario real, no "sanddy">
ADMIN_INITIAL_PASSWORD=<password real y fuerte, no "sanddy2026">
COOKIE_SECURE=true

# --- Solo para el seed manual (no es una variable de la app en runtime) ---
# false = el seed solo crea el usuario admin, sin categorías/productos/pedido de ejemplo.
SEED_SAMPLE_DATA=false
