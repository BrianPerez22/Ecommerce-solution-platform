# Credenciales de solo-desarrollo (coinciden con docker-compose.yml). No usar en producción.
DATABASE_URL=postgresql://sanddy:sanddy@localhost:5432/sanddy_almacen?schema=public
PORT=3001
# Uno o varios orígenes separados por coma (sin espacios extra necesarios, se recortan solos)
CORS_ORIGIN=http://localhost:5173
UPLOADS_DIR=uploads

# Almacenamiento de imágenes de producto: 'local' (disco, default) o 'azure' (Blob Storage).
# En local no cambies esto — así el flujo de siempre (npm run dev) sigue igual.
STORAGE_DRIVER=local
# Solo se usan si STORAGE_DRIVER=azure. En local pueden quedar vacías.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=productos

# Autenticación de admin (ver docs/architecture.md). Cambiar JWT_SECRET en producción.
JWT_SECRET=dev-secret-cambiar-en-produccion
ADMIN_INITIAL_USERNAME=sanddy
ADMIN_INITIAL_PASSWORD=sanddy2026

# Cookie de sesión: en local (HTTP) debe quedar en false. En producción (HTTPS) debe ser
# true — ver docs/apps/despliegue-azure.md, Fase 5.
COOKIE_SECURE=false
