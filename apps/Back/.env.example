# Credenciales de solo-desarrollo. No usar en producción.
DATABASE_URL=postgresql://sanddy:sanddy@localhost:5432/sanddy_almacen?schema=public
PORT=3001

# Solo se usa en desarrollo, cuando el front corre aparte en Vite. En producción el
# backend sirve el front y no hay petición entre orígenes que autorizar.
CORS_ORIGIN=http://localhost:5173

# Autenticación de admin (ver docs/architecture.md). Cambiar JWT_SECRET en producción.
JWT_SECRET=dev-secret-cambiar-en-produccion
ADMIN_INITIAL_USERNAME=sanddy
ADMIN_INITIAL_PASSWORD=sanddy2026

# En producción (NODE_ENV=production) el backend marca la cookie de sesión como Secure y
# sirve el build del front desde FRONTEND_DIST (por defecto ../Front/dist).
